# Copy to .env.local. For the local stack, fill these from `npx supabase status -o env`:
#   API_URL -> NEXT_PUBLIC_SUPABASE_URL
#   PUBLISHABLE_KEY (or ANON_KEY) -> NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
#   SECRET_KEY (or SERVICE_ROLE_KEY) -> SUPABASE_SECRET_KEY
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Bypasses RLS: never expose it to the browser or commit it.
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
